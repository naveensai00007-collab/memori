# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL 17 or SQLite file)
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="your-32-character-secret-key-here"
JWT_REFRESH_SECRET="your-32-character-refresh-secret-here"
JWT_EXPIRY="15m"
REFRESH_EXPIRY="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
FRONTEND_URL="http://localhost:5188"

# Email Notifications (Free Gmail App Password / SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@memori.app"
SMTP_PASS="app-password-here"
SMTP_FROM="MEMORI <notifications@memori.app>"

# Logging Level
LOG_LEVEL="info"
